# PLACEHOLDERS ONLY. Copy to an ignored file and fill privately.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_RESOURCE_URL=https://YOUR-MCP-HOST/mcp
MCP_OAUTH_AUDIENCE=<MUST_MATCH_MCP_RESOURCE_URL exactly>
MCP_OAUTH_ISSUER=https://YOUR-TENANT.logto.app/oidc
# Comma-separated origin URLs for browser-based MCP Playground (omit for loopback-only).
# MCP_ALLOWED_ORIGINS=https://CODESPACES-NAME-XXXX.preview.app.github.dev
MCP_OAUTH_AUTHORIZATION_URL=https://YOUR-TENANT.logto.app/oidc/auth
MCP_OAUTH_TOKEN_URL=https://YOUR-TENANT.logto.app/oidc/token
MCP_OAUTH_JWKS_URL=https://YOUR-TENANT.logto.app/oidc/jwks
MCP_BACKEND_URL=http://127.0.0.1:8000
MCP_BACKEND_TOKEN=
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_ACCESS_TOKEN=
# RAG_API_BASE_URL/RAG_API_KEY/RAG_GENERATION_MODEL come from existing ignored backend/.env.
